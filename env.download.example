# Copy these settings to .env.local and fill them in locally.
# Never commit real tokens or private database URLs.
TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# Production database for the Vercel "Production" environment (preferred over the two above there).
KIZUNA_TURSO_DATABASE_URL=
KIZUNA_TURSO_AUTH_TOKEN=

# Django (required on Vercel).
DJANGO_SECRET_KEY=

# Gemini Live voice energy agent (server mints a short-lived token; leave empty to disable).
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=

# STEG back-office demo password. Unset = the STEG demo account cannot sign in.
MIERUKA_STEG_PASSWORD=
